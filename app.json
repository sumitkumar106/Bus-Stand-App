{
  "expo": {
    "name": "Bus Stand",
    "slug": "bus-stand-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "busstand",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#000000"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.busstand.app",
      "googleMobileAdsAppId": "ca-app-pub-6801510207917997~4471324247",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Allow Bus Stand to use your location for real-time bus tracking and accurate arrival predictions.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "Allow Bus Stand to use your location for real-time bus tracking and accurate arrival predictions.",
        "NSMotionUsageDescription": "This app uses motion data to enhance the user experience with smooth animations and better navigation."
      },
      "statusBar": {
        "hidden": false,
        "translucent": false,
        "style": "default"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#000000"
      },
      "package": "com.busstand.app",
      "versionCode": 1,
      "minSdkVersion": 21,
      "targetSdkVersion": 34",
      "googleMobileAdsAppId": "ca-app-pub-6801510207917997~6362172176",
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "FOREGROUND_SERVICE",
        "VIBRATE",
        "WAKE_LOCK"
      ],
      "intentFilters": [
        {
          "action": "android.intent.action.VIEW",
          "data": "magnet:?*",
          "autoVerify": true
        },
        {
          "action": "android.intent.action.WEB_SEARCH"
        }
      ],
      "config": {
        "googleMobileAds": {
          "sameAppKey": true,
          "sameAppKeyEnabled": true
        }
      }
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png",
      "meta": {
        "description": "Bus Stand - Real-time bus tracking and arrival predictions for passengers and drivers in India",
        "keywords": ["bus", "transportation", "tracking", "india", "patna", "harinagar", "sonpur"],
        "og:title": "Bus Stand - Bus Tracking App",
        "og:description": "Track buses in real-time, get accurate arrival predictions, and set arrival alerts.",
        "og:image": "./assets/images/icon.png",
        "og:type": "website"
      }
    },
    "plugins": [
      "expo-router",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Allow Bus Stand to use your location for real-time bus tracking and accurate arrival predictions."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/icon.png",
          "color": "#ffffff",
          "sounds": [
            "./assets/sounds/notification.wav"
          ]
        }
      ],
      [
        "expo-asset"
      ],
      [
        "expo-font"
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true,
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "1d5b2236-67bd-4a48-8fb2-ed6675406aeb"
      }
    },
    "owner": "bus-stand-team"
  }
}
